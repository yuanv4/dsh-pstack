{
  "name": "pstack-dsh",
  "description": "DeepSeek Harness adaptation of poteto's pstack. Skills and agents are generated from cursor/plugins; only the harness call layer is this repo's own code.",
  "version": "0.3.0",
  "license": "MIT",
  "type": "module",
  "main": "harness/pstack/dsh/dist/index.js",
  "types": "harness/pstack/dsh/dist/index.d.ts",
  "files": [
    "harness/pstack/dsh/dist",
    "harness/pstack/dsh/generated",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./harness/pstack/dsh/dist/index.d.ts",
      "default": "./harness/pstack/dsh/dist/index.js"
    },
    "./client": "./harness/pstack/dsh/dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "sync:skills": "node scripts/fetch-upstream.mjs && node scripts/generate-pstack-harness-trees.mjs",
    "test": "npm run build && node --experimental-strip-types --test harness/pstack/dsh/tests/*.spec.ts",
    "check": "node scripts/generate-pstack-harness-trees.mjs --check && npm run typecheck && npm run test",
    "check:package": "node scripts/generate-pstack-harness-trees.mjs --check && npm run build && node scripts/smoke-package.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24",
    "dsh": ">=0.2.2-rc.4 <0.2.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuanv4/dsh-pstack.git"
  },
  "homepage": "https://github.com/yuanv4/dsh-pstack",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "pstack",
    "poteto-mode"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent": ">=0.2.2-rc.4 <0.2.3",
    "@deepseek-ai/dsh-api-remotes": ">=0.2.2-rc.4 <0.2.3",
    "@deepseek-ai/dsh-atomic-write": ">=0.2.2-rc.4 <0.2.3",
    "@deepseek-ai/dsh-client-locale": ">=0.2.2-rc.4 <0.2.3",
    "@deepseek-ai/dsh-client-connection": ">=0.2.2-rc.4 <0.2.3",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.2-rc.4 <0.2.3",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.2-rc.4 <0.2.3",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.2-rc.4",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.2-rc.4 <0.2.3",
    "@deepseek-ai/dsh-credentials": ">=0.2.2-rc.4 <0.2.3",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.2-rc.4 <0.2.3",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.4 <0.2.3",
    "@deepseek-ai/dsh-settings": ">=0.2.2-rc.4 <0.2.3",
    "@deepseek-ai/dsh-skill": ">=0.2.2-rc.4 <0.2.3",
    "@deepseek-ai/dsh-subagent": ">=0.2.2-rc.4 <0.2.3",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.4 <0.2.3",
    "@deepseek-ai/dsh-util-values": ">=0.2.2-rc.4 <0.2.3",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-atomic-write": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-subagent": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.4",
    "@deepseek-ai/dsh-api-remotes": "0.2.2-rc.4",
    "@deepseek-ai/dsh-atomic-write": "0.2.2-rc.4",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.4",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.4",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.4",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.4",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.2-rc.4",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.4",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.4",
    "@deepseek-ai/dsh-host-webserver": "0.2.2-rc.4",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.4",
    "@deepseek-ai/dsh-settings": "0.2.2-rc.4",
    "@deepseek-ai/dsh-skill": "0.2.2-rc.4",
    "@deepseek-ai/dsh-subagent": "0.2.2-rc.4",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.4",
    "@deepseek-ai/dsh-util-values": "0.2.2-rc.4",
    "@types/node": "^22.20.0",
    "@types/semver": "^7.7.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "esbuild": "^0.27.3",
    "semver": "^7.7.2",
    "typescript": "^6.0.3"
  }
}
