{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "noEmit": true,
    "rootDir": ".",
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["harness/pstack/dsh/src/**/*.ts", "harness/pstack/dsh/tests/**/*.ts"],
  "exclude": ["harness/pstack/dsh/src/client", "harness/pstack/dsh/dist"]
}
